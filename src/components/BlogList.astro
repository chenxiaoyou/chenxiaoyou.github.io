---
import type { CollectionEntry } from "astro:content";

interface Props {
  entries: CollectionEntry<"blogs">[];
}

const { entries } = Astro.props;
const zhFormatter = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
});
const enFormatter = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
});
const pathFor = (entry: CollectionEntry<"blogs">) => `/blogs/${entry.id.replace(/\.(md|mdx)$/, "")}/`;
---

<div class="blog-list">
  {
    entries.map((entry) => (
      <article class="blog-row">
        <a class="blog-link" href={pathFor(entry)} target="_blank" rel="noopener noreferrer">
          <div class="blog-main">
            <h3>{entry.data.title}</h3>
            <p>{entry.data.description}</p>
            <div class="blog-tags" aria-label="标签">
              {entry.data.tags.map((tag) => <span>{tag}</span>)}
            </div>
          </div>
          <time
            datetime={entry.data.publishedAt.toISOString()}
            data-i18n-date
            data-date-zh={zhFormatter.format(entry.data.publishedAt)}
            data-date-en={enFormatter.format(entry.data.publishedAt)}
          >
            {zhFormatter.format(entry.data.publishedAt)}
          </time>
          <span class="row-arrow" aria-hidden="true">›</span>
        </a>
      </article>
    ))
  }
</div>
