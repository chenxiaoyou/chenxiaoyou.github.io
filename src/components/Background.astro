<section class="section background-section" id="experience" aria-labelledby="experience-title">
  <div class="container">
    <header class="section-head" data-reveal>
      <p class="section-tag"><span class="section-num">02</span><span data-i18n="navExperience">经历</span></p>
      <h2 id="experience-title" class="section-title" data-i18n="expTitle">经历</h2>
    </header>

    <div class="timeline" aria-label="工作与教育时间线">
      <article class="timeline-item" data-reveal>
        <div class="timeline-marker"><span class="marker-dot"></span></div>
        <div class="timeline-card">
          <div class="timeline-top">
            <div class="timeline-id">
              <span class="badge badge-work" data-i18n="badgeWork">工作</span>
              <span class="badge badge-current" data-i18n="badgeCurrent">当前</span>
              <h3 class="timeline-org">
                <span data-i18n="workBdName">字节跳动</span>
                <a
                  class="org-arrow"
                  href="https://www.bytedance.com/"
                  target="_blank"
                  rel="noopener noreferrer"
                  data-i18n-label="workBdHome"
                  aria-label="打开字节跳动主页">↗</a
                >
              </h3>
              <p class="timeline-role" data-i18n="workBdRole">测试开发</p>
            </div>
            <div class="timeline-meta">
              <span class="timeline-date" data-i18n="workBdDate">北京 | 2021.06 - 至今</span>
              <button
                class="detail-toggle"
                type="button"
                data-detail-toggle="work-detail"
                aria-controls="work-detail"
                aria-expanded="false"
                data-i18n-label="workDetailToggle"
                aria-label="展开工作内容">›</button
              >
            </div>
          </div>
          <div class="timeline-detail terminal-detail" id="work-detail" hidden>
            <div class="terminal-line">
              <span class="terminal-key terminal-key-problem">Problem</span>
              <span data-i18n="workProblem">业务迭代快，质量回归和稳定性风险需要更早暴露。</span>
            </div>
            <div class="terminal-line">
              <span class="terminal-key terminal-key-action">Action</span>
              <span data-i18n="workAction">建设自动化用例、CI 门禁、巡检脚本和问题复盘链路。</span>
            </div>
            <div class="terminal-line">
              <span class="terminal-key terminal-key-result">Result</span>
              <span data-i18n="workResult">自动化回归覆盖核心链路，版本回归耗时显著下降，线上风险通过巡检与复盘持续收敛。</span>
            </div>
          </div>
        </div>
      </article>

      <article class="timeline-item" data-reveal style="--reveal-delay: .08s">
        <div class="timeline-marker"><span class="marker-dot"></span></div>
        <div class="timeline-card">
          <div class="timeline-top">
            <div class="timeline-id">
              <span class="badge badge-edu" data-i18n="badgeEdu">教育</span>
              <h3 class="timeline-org">
                <span data-i18n="eduBuptName">北京邮电大学</span>
                <a
                  class="org-arrow"
                  href="https://www.bupt.edu.cn/"
                  target="_blank"
                  rel="noopener noreferrer"
                  data-i18n-label="eduBuptHome"
                  aria-label="打开北京邮电大学主页">↗</a
                >
              </h3>
              <p class="timeline-role" data-i18n="eduBuptDesc">硕士 | 电子与通信工程</p>
            </div>
            <div class="timeline-meta">
              <time class="timeline-date" datetime="2018/2021">2018 - 2021</time>
            </div>
          </div>
        </div>
      </article>

      <article class="timeline-item" data-reveal style="--reveal-delay: .16s">
        <div class="timeline-marker"><span class="marker-dot"></span></div>
        <div class="timeline-card">
          <div class="timeline-top">
            <div class="timeline-id">
              <span class="badge badge-edu" data-i18n="badgeEdu">教育</span>
              <h3 class="timeline-org">
                <span data-i18n="eduNjuptName">南京邮电大学</span>
                <a
                  class="org-arrow"
                  href="https://www.njupt.edu.cn/"
                  target="_blank"
                  rel="noopener noreferrer"
                  data-i18n-label="eduNjuptHome"
                  aria-label="打开南京邮电大学主页">↗</a
                >
              </h3>
              <p class="timeline-role" data-i18n="eduNjuptDesc">本科 | 信息安全</p>
            </div>
            <div class="timeline-meta">
              <time class="timeline-date" datetime="2012/2016">2012 - 2016</time>
            </div>
          </div>
        </div>
      </article>
    </div>

    <div class="tech-stack">
      <h3 class="tech-heading" data-i18n="techTitle">技术栈</h3>
      <div class="tech-grid" aria-label="技术栈">
        <article class="tech-card" data-reveal>
          <h4 data-i18n="techAutomationTitle">测试自动化</h4>
          <div class="tech-chip-list">
            <span class="tech-chip" tabindex="0" data-icon="PY" data-skill="脚本 / 平台 / 数据处理" data-i18n-skill="skillPython">Python</span>
            <span class="tech-chip" tabindex="0" data-icon="PT" data-skill="接口 / 回归 / 断言" data-i18n-skill="skillPytest">Pytest</span>
            <span class="tech-chip" tabindex="0" data-icon="PW" data-skill="Web E2E / 录制回放" data-i18n-skill="skillPlaywright">Playwright</span>
            <span class="tech-chip" tabindex="0" data-icon="SE" data-skill="浏览器自动化" data-i18n-skill="skillSelenium">Selenium</span>
          </div>
        </article>
        <article class="tech-card" data-reveal style="--reveal-delay: .06s">
          <h4 data-i18n="techEngineeringTitle">工程语言</h4>
          <div class="tech-chip-list">
            <span class="tech-chip" tabindex="0" data-icon="JV" data-skill="服务端测试工具" data-i18n-skill="skillJava">Java</span>
            <span class="tech-chip" tabindex="0" data-icon="GO" data-skill="高并发工具 / CLI" data-i18n-skill="skillGo">Go</span>
            <span class="tech-chip" tabindex="0" data-icon="TS" data-skill="前端工具链" data-i18n-skill="skillTs">TypeScript</span>
            <span class="tech-chip" tabindex="0" data-icon="DB" data-skill="数据校验 / 排障" data-i18n-skill="skillSql">SQL</span>
          </div>
        </article>
        <article class="tech-card" data-reveal style="--reveal-delay: .12s">
          <h4 data-i18n="techCiTitle">CI / 工具链</h4>
          <div class="tech-chip-list">
            <span class="tech-chip" tabindex="0" data-icon="JN" data-skill="流水线编排" data-i18n-skill="skillJenkins">Jenkins</span>
            <span class="tech-chip" tabindex="0" data-icon="CI" data-skill="质量门禁" data-i18n-skill="skillGitlab">GitLab CI</span>
            <span class="tech-chip" tabindex="0" data-icon="DK" data-skill="环境一致性" data-i18n-skill="skillDocker">Docker</span>
            <span class="tech-chip" tabindex="0" data-icon="LX" data-skill="日志 / 进程 / 网络" data-i18n-skill="skillLinux">Linux</span>
          </div>
        </article>
        <article class="tech-card" data-reveal style="--reveal-delay: .18s">
          <h4 data-i18n="techReliabilityTitle">稳定性观测</h4>
          <div class="tech-chip-list">
            <span class="tech-chip" tabindex="0" data-icon="PM" data-skill="指标采集" data-i18n-skill="skillPrometheus">Prometheus</span>
            <span class="tech-chip" tabindex="0" data-icon="GF" data-skill="看板 / 趋势" data-i18n-skill="skillGrafana">Grafana</span>
            <span class="tech-chip" tabindex="0" data-icon="LG" data-skill="问题定位" data-i18n-skill="skillLog">日志分析</span>
            <span class="tech-chip" tabindex="0" data-icon="AL" data-skill="风险前置" data-i18n-skill="skillAlert">告警巡检</span>
          </div>
        </article>
      </div>
    </div>
  </div>
</section>
