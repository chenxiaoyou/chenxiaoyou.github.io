<header class="top-dock utility-dock" aria-label="页面工具">
  <div class="controls dock-controls" aria-label="偏好设置">
    <a
      class="dock-button dock-icon blogs-link"
      href="/blogs/"
      target="_blank"
      rel="noopener noreferrer"
      data-i18n-label="dockBlogs"
      data-i18n-title="dockBlogs"
      aria-label="博客"
      title="博客"
    >
      <span class="blogs-icon" aria-hidden="true"></span>
    </a>
    <span class="dock-divider" aria-hidden="true"></span>
    <a
      class="dock-button dock-icon resume-link"
      href="/assets/resume.pdf"
      download
      data-i18n-label="dockResume"
      data-i18n-title="dockResume"
      aria-label="简历"
      title="简历"
      data-resume-meta="PDF"
    >
      <span class="resume-icon" aria-hidden="true"></span>
    </a>
    <a
      class="dock-button dock-icon github-link"
      href="https://github.com/chenxiaoyou"
      target="_blank"
      rel="noopener noreferrer"
      data-i18n-label="dockGithub"
      data-i18n-title="dockGithub"
      aria-label="GitHub"
      title="GitHub"
    >
      <svg class="contact-icon github-icon" viewBox="0 0 24 24" aria-hidden="true">
        <path fill="currentColor" d="M12 .6a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2.1c-3.3.7-4-1.4-4-1.4-.5-1.4-1.3-1.7-1.3-1.7-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1.1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.4-1.3-5.4-5.9 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.3 1.2a11.4 11.4 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.6 1.6.2 2.8.1 3.1.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.4 5.9.4.4.8 1.1.8 2.2v3.2c0 .3.2.7.8.6A12 12 0 0 0 12 .6Z" />
      </svg>
    </a>
    <a
      class="dock-button dock-icon email-link"
      href="mailto:chenxiaoyou19@gmail.com"
      data-i18n-label="dockEmail"
      data-i18n-title="dockEmail"
      aria-label="发送邮件"
      title="发送邮件"
    >
      <svg class="contact-icon email-icon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M3 5.5h18v13H3z" />
        <path d="m4 7 8 6 8-6" />
      </svg>
    </a>
    <span class="dock-divider" aria-hidden="true"></span>
    <button
      class="dock-button dock-icon control-button theme-toggle"
      type="button"
      data-theme-toggle
      aria-label="暗黑模式"
      title="暗黑模式"
    >
      <span class="theme-icon" aria-hidden="true"></span>
    </button>
    <button
      class="dock-button dock-icon control-button lang-toggle"
      type="button"
      data-lang-toggle
      data-i18n-label="languageToggle"
      data-i18n-title="languageToggle"
      aria-label="切换语言"
      title="切换语言"
    >
      中
    </button>
  </div>
</header>
