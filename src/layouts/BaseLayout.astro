---
import UtilityDock from "../components/UtilityDock.astro";

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  mainId?: string;
}

const { title, description, canonicalPath, mainId = "hero" } = Astro.props;
const canonicalURL = new URL(canonicalPath, Astro.site);
const ogImage = new URL("/assets/profile.png", Astro.site);
---

<!doctype html>
<html lang="zh-CN" data-theme="dark" data-lang="zh">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="theme-color" content="#070b12" />
    <link rel="icon" href="/assets/profile.png" type="image/png" />
    <link rel="stylesheet" href="/assets/styles.css" />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.classList.add("js");
        try {
          const theme = localStorage.getItem("site-theme");
          if (theme === "light" || theme === "dark") root.dataset.theme = theme;
          const lang = localStorage.getItem("site-language");
          if (lang === "zh" || lang === "en") root.dataset.lang = lang;
        } catch {}
      })();
    </script>
    <script is:inline src="/assets/site.js" defer></script>
  </head>
  <body>
    <a class="skip-link" href={`#${mainId}`} data-i18n="skip">跳到正文</a>
    <UtilityDock />
    <slot />
  </body>
</html>
