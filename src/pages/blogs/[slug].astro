---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const entries = await getCollection("blogs", ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.id.replace(/\.(md|mdx)$/, "") },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"blogs">;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const tableOfContents = headings.filter(({ depth }) => depth === 2 || depth === 3);
const slug = entry.id.replace(/\.(md|mdx)$/, "");
const zhFormatter = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
const enFormatter = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<BaseLayout
  title={`${entry.data.title} | 辰小右`}
  description={entry.data.description}
  canonicalPath={`/blogs/${slug}/`}
>
  <main class="blog-page section" id="content">
    <a class="blogs-back" href="/blogs/" data-i18n="backBlogs">‹ 返回博客</a>
    <header class="blog-header">
      <h1>{entry.data.title}</h1>
      <p class="blog-description">{entry.data.description}</p>
      <div class="blog-meta">
        <span data-i18n="publishedLabel">发布于</span>
        <time
          datetime={entry.data.publishedAt.toISOString()}
          data-i18n-date
          data-date-zh={zhFormatter.format(entry.data.publishedAt)}
          data-date-en={enFormatter.format(entry.data.publishedAt)}
        >
          {zhFormatter.format(entry.data.publishedAt)}
        </time>
        {
          entry.data.updatedAt && (
            <>
              <span class="blog-meta-divider">/</span>
              <span data-i18n="updatedLabel">更新于</span>
              <time
                datetime={entry.data.updatedAt.toISOString()}
                data-i18n-date
                data-date-zh={zhFormatter.format(entry.data.updatedAt)}
                data-date-en={enFormatter.format(entry.data.updatedAt)}
              >
                {zhFormatter.format(entry.data.updatedAt)}
              </time>
            </>
          )
        }
      </div>
      <div class="blog-tags" aria-label="标签">
        {entry.data.tags.map((tag) => <span>{tag}</span>)}
      </div>
    </header>
    <div class="blog-layout">
      <details class="blog-toc" open>
        <summary data-i18n="tocTitle">目录</summary>
        <ol>
          {
            tableOfContents.map((heading) => (
              <li class:list={{ nested: heading.depth === 3 }}>
                <a href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))
          }
        </ol>
      </details>
      <article class="prose">
        <Content />
      </article>
    </div>
  </main>
</BaseLayout>
