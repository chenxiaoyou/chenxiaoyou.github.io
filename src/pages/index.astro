---
import { getCollection } from "astro:content";
import BlogList from "../components/BlogList.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const publishedBlogs = (await getCollection("blogs", ({ data }) => !data.draft)).sort(
  (left, right) => right.data.publishedAt.valueOf() - left.data.publishedAt.valueOf(),
);
const latestBlogs = publishedBlogs.slice(0, 3);
---

<BaseLayout
  title="辰小右"
  description="辰小右的在线简历，展示测试开发、泛自动化、稳定性方向的个人介绍、教育背景、工作经历、技术栈与技术博客。"
  canonicalPath="/"
  mainId="hero"
>
  <main id="top">
    <section class="hero section" id="hero" aria-labelledby="hero-title">
      <div class="hero-stage">
        <div class="hero-card">
          <div class="hero-copy">
            <h1 id="hero-title" data-i18n="name">辰小右</h1>
            <p class="hero-role" data-i18n="role">测试开发 / 泛自动化 / 稳定性工程</p>
            <p class="hero-summary" data-i18n="intro">
              我关注用工程化方式提升质量效率，长期投入自动化测试、CI 质量门禁、稳定性巡检和故障复盘。
            </p>
            <p class="brand-tagline" data-i18n="brandTagline">Quality Engineering / Automation / Reliability</p>
            <div class="hero-signal-grid" aria-label="关键方向">
              <span class="signal-chip" data-i18n="signalCi">CI 质量门禁</span>
              <span class="signal-chip" data-i18n="signalAuto">自动化巡检</span>
              <span class="signal-chip" data-i18n="signalReliability">稳定性治理</span>
              <span class="signal-chip" data-i18n="signalReview">故障复盘</span>
            </div>
          </div>
          <div class="hero-photo-shell">
            <img class="profile-photo" src="/assets/profile.png" alt="辰小右头像" data-i18n-alt="profileAlt" />
          </div>
        </div>
      </div>
    </section>

    <section class="section about-section" id="about" aria-labelledby="about-title">
      <div class="about-wrap">
        <h2 id="about-title" class="background-label" data-i18n="aboutTitle">关于我</h2>
        <article class="about-row">
          <div class="about-main">
            <p class="about-copy" data-i18n="aboutCopy">这里先占位：补充职业方向、优势和目标岗位。</p>
            <div class="about-points" aria-label="关于我补充要点">
              <span class="about-point" data-i18n="aboutPointOne">求职方向待补充</span>
              <span class="about-point" data-i18n="aboutPointTwo">个人优势待补充</span>
              <span class="about-point" data-i18n="aboutPointThree">近期关注待补充</span>
            </div>
          </div>
        </article>
      </div>
    </section>

    <section class="section background-section" id="background" aria-labelledby="background-title">
      <h2 id="background-title" class="sr-only" data-i18n="backgroundTitle">教育与工作背景</h2>
      <div class="background-board">
        <div class="background-group" id="experience">
          <h3 class="background-label" data-i18n="workTitle">工作经历</h3>
          <div class="background-list">
            <article class="background-row">
              <div class="org-mark">
                <img class="org-logo" src="/assets/logo-bytedance.svg" alt="字节跳动 logo" />
              </div>
              <div class="row-main">
                <h4>
                  <span data-i18n="workBdName">字节跳动</span>
                  <a
                    class="row-arrow name-link-arrow"
                    href="https://www.bytedance.com/"
                    target="_blank"
                    rel="noopener noreferrer"
                    data-i18n-label="workBdHome"
                    aria-label="打开字节跳动主页">›</a
                  >
                </h4>
                <p data-i18n="workBdRole">测试开发</p>
              </div>
              <div class="row-date">
                <span data-i18n="workBdDate">北京 | 2021.06 - 至今</span>
                <button
                  class="row-arrow detail-toggle work-detail-toggle"
                  type="button"
                  data-detail-toggle="work-bytedance-detail"
                  aria-controls="work-bytedance-detail"
                  aria-expanded="false"
                  data-i18n-label="workDetailToggle"
                  aria-label="展开工作内容">›</button
                >
              </div>
              <div class="row-detail work-detail-panel terminal-detail" id="work-bytedance-detail" hidden>
                <div class="terminal-line">
                  <span class="terminal-key">Problem</span>
                  <span data-i18n="workProblem">业务迭代快，质量回归和稳定性风险需要更早暴露。</span>
                </div>
                <div class="terminal-line">
                  <span class="terminal-key">Action</span>
                  <span data-i18n="workAction">建设自动化用例、CI 门禁、巡检脚本和问题复盘链路。</span>
                </div>
                <div class="terminal-line">
                  <span class="terminal-key">Result</span>
                  <span data-i18n="workResult">指标暂留占位：补充覆盖率、拦截率、耗时下降等结果。</span>
                </div>
              </div>
            </article>
          </div>
        </div>

        <div class="background-group" id="education">
          <h3 class="background-label" data-i18n="educationTitle">教育背景</h3>
          <div class="background-list">
            <article class="background-row">
              <div class="org-mark">
                <img class="org-logo" src="/assets/logo-bupt.png" alt="北京邮电大学 logo" />
              </div>
              <div class="row-main">
                <h4>
                  <span data-i18n="eduBuptName">北京邮电大学</span>
                  <a
                    class="row-arrow name-link-arrow"
                    href="https://www.bupt.edu.cn/"
                    target="_blank"
                    rel="noopener noreferrer"
                    data-i18n-label="eduBuptHome"
                    aria-label="打开北京邮电大学主页">›</a
                  >
                </h4>
                <p data-i18n="eduBuptDesc">硕士 | 电子与通信工程</p>
              </div>
              <time class="row-date" datetime="2018/2021">2018 - 2021</time>
            </article>

            <article class="background-row">
              <div class="org-mark">
                <img class="org-logo" src="/assets/logo-njupt.png" alt="南京邮电大学 logo" />
              </div>
              <div class="row-main">
                <h4>
                  <span data-i18n="eduNjuptName">南京邮电大学</span>
                  <a
                    class="row-arrow name-link-arrow"
                    href="https://www.njupt.edu.cn/"
                    target="_blank"
                    rel="noopener noreferrer"
                    data-i18n-label="eduNjuptHome"
                    aria-label="打开南京邮电大学主页">›</a
                  >
                </h4>
                <p data-i18n="eduNjuptDesc">本科 | 信息安全</p>
              </div>
              <time class="row-date" datetime="2012/2016">2012 - 2016</time>
            </article>
          </div>
        </div>

        <div class="background-group tech-stack" id="tech-stack">
          <h3 class="background-label" data-i18n="techTitle">技术栈</h3>
          <div class="tech-grid" aria-label="技术栈">
            <article class="tech-card">
              <h4 data-i18n="techAutomationTitle">测试自动化</h4>
              <div class="tech-chip-list">
                <span class="tech-chip" data-icon="PY" data-skill="脚本 / 平台 / 数据处理" data-i18n-skill="skillPython">Python</span>
                <span class="tech-chip" data-icon="PT" data-skill="接口 / 回归 / 断言" data-i18n-skill="skillPytest">Pytest</span>
                <span class="tech-chip" data-icon="PW" data-skill="Web E2E / 录制回放" data-i18n-skill="skillPlaywright">Playwright</span>
                <span class="tech-chip" data-icon="SE" data-skill="浏览器自动化" data-i18n-skill="skillSelenium">Selenium</span>
              </div>
            </article>
            <article class="tech-card">
              <h4 data-i18n="techEngineeringTitle">工程语言</h4>
              <div class="tech-chip-list">
                <span class="tech-chip" data-icon="JV" data-skill="服务端测试工具" data-i18n-skill="skillJava">Java</span>
                <span class="tech-chip" data-icon="GO" data-skill="高并发工具 / CLI" data-i18n-skill="skillGo">Go</span>
                <span class="tech-chip" data-icon="TS" data-skill="前端工具链" data-i18n-skill="skillTs">TypeScript</span>
                <span class="tech-chip" data-icon="DB" data-skill="数据校验 / 排障" data-i18n-skill="skillSql">SQL</span>
              </div>
            </article>
            <article class="tech-card">
              <h4 data-i18n="techCiTitle">CI / 工具链</h4>
              <div class="tech-chip-list">
                <span class="tech-chip" data-icon="JN" data-skill="流水线编排" data-i18n-skill="skillJenkins">Jenkins</span>
                <span class="tech-chip" data-icon="CI" data-skill="质量门禁" data-i18n-skill="skillGitlab">GitLab CI</span>
                <span class="tech-chip" data-icon="DK" data-skill="环境一致性" data-i18n-skill="skillDocker">Docker</span>
                <span class="tech-chip" data-icon="LX" data-skill="日志 / 进程 / 网络" data-i18n-skill="skillLinux">Linux</span>
              </div>
            </article>
            <article class="tech-card">
              <h4 data-i18n="techReliabilityTitle">稳定性观测</h4>
              <div class="tech-chip-list">
                <span class="tech-chip" data-icon="PM" data-skill="指标采集" data-i18n-skill="skillPrometheus">Prometheus</span>
                <span class="tech-chip" data-icon="GF" data-skill="看板 / 趋势" data-i18n-skill="skillGrafana">Grafana</span>
                <span class="tech-chip" data-icon="LG" data-skill="问题定位" data-i18n="techLogChip" data-i18n-skill="skillLog">日志分析</span>
                <span class="tech-chip" data-icon="AL" data-skill="风险前置" data-i18n="techAlertChip" data-i18n-skill="skillAlert">告警巡检</span>
              </div>
            </article>
          </div>
        </div>
      </div>
    </section>

    <section class="section blogs-section" id="blogs" aria-labelledby="blogs-title">
      <div class="blogs-wrap">
        <div class="blogs-heading">
          <h2 id="blogs-title" class="background-label" data-i18n="blogsTitle">博客</h2>
          <a class="blogs-all" href="/blogs/" target="_blank" rel="noopener noreferrer" data-i18n="blogsAll">查看全部 ›</a>
        </div>
        <BlogList entries={latestBlogs} />
      </div>
    </section>
  </main>
</BaseLayout>
