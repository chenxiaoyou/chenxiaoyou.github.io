---
import { getCollection } from "astro:content";
import DocumentList from "../../components/DocumentList.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const publishedDocs = (await getCollection("docs", ({ data }) => !data.draft)).sort(
  (left, right) => right.data.publishedAt.valueOf() - left.data.publishedAt.valueOf(),
);
---

<BaseLayout
  title="文档 | 辰小右"
  description="辰小右的工程文档与技术实践记录。"
  canonicalPath="/docs/"
>
  <main class="docs-page section" id="content">
    <header class="docs-header">
      <a class="docs-back" href="/" data-i18n="backHome">‹ 返回主页</a>
      <h1 data-i18n="documentsIndexTitle">全部文档</h1>
      <p data-i18n="documentsIntro">记录测试开发、自动化和稳定性工程中的实践与思考。</p>
    </header>
    <DocumentList entries={publishedDocs} />
  </main>
</BaseLayout>
